<?xml version="1.0"?>
<launch>

  <!-- <set_env name="VENVPYTHONPATH" value="/root/workspace/psi-policy/.venv/bin/python3" /> -->
  <set_env name="VENVPYTHONPATH" value="/usr/bin/python3" />

  <!-- IK -->  
  <include file="$(find-pkg-share arm)/launch/launch_arm_ik.launch.py">     
    <arg name="ik_enable_viewer" value="true" />
    <arg name="ik_frequency" value="100.0" />
    <arg name="ik_solver" value="daqp" />
  </include>

  <!-- Left Arm FK -->
  <include file="$(find-pkg-share arm)/launch/launch_arm_fk.launch.py">
      <arg name="fk_arm_side" value="left" />
      <arg name="fk_frequency" value="100.0" />
  </include>

  <!-- Right Arm FK -->
  <include file="$(find-pkg-share arm)/launch/launch_arm_fk.launch.py">
      <arg name="fk_arm_side" value="right" />
      <arg name="fk_frequency" value="100.0" />
  </include>

  <!-- Left Arm Control -->
  <include file="$(find-pkg-share arm)/launch/launch_ruckig_control.xml">
      <arg name="control_arm_side" value="left" />
  </include>

  <!-- Right Arm Control -->
  <include file="$(find-pkg-share arm)/launch/launch_ruckig_control.xml">
      <arg name="control_arm_side" value="right" />
  </include>
  
</launch> 